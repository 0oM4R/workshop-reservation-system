# Copy to .env to override. Every value below is the default.

# SQLAlchemy async URL of the application database.
DATABASE_URL=postgresql+asyncpg://workshops:workshops@localhost:5432/workshops

# Database used by the backend tests; truncated between tests.
TEST_DATABASE_URL=postgresql+asyncpg://workshops:workshops@localhost:5432/workshops_test

# Insert demo workshops when the seed script runs (true/false).
SEED_DATA=false
